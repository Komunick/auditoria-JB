# Auditoria Fiscal Web — valores deste sistema para o devops/ctl.sh.
# Tudo aqui pode ser sobrescrito por variável de ambiente na hora de rodar.

# Nome curto do serviço (usado no log, no pgrep e na marca do cron).
SERVICO="auditoria-fiscal"
NOME_LONGO="Auditoria Fiscal Web"

# Script de entrada, relativo à raiz do repositório (é ele que sobe o uvicorn).
ENTRADA_REL="servidor.py"

# Lista de dependências, relativa à raiz do repositório. O padrão instala só o
# que o SITE usa — o requirements.txt da raiz traz PySide6 e fdb, que são do
# aplicativo desktop, pesam centenas de MB e o servidor.py nunca importa (a VM
# tem pouco espaço livre). Troque por "requirements.txt" se quiser tudo.
REQUISITOS_REL="devops/requirements-web.txt"

# Porta padrão e pasta de dados.
PORTA_PADRAO="8600"
DATA_SUBDIR="auditoria-data"

# Nomes das variáveis de ambiente que o servidor.py lê.
PORTA_ENV="AUDITORIA_WEB_PORTA"
DATA_ENV="AUDITORIA_WEB_DADOS"

# Teto por arquivo enviado, em MB (AUDITORIA_WEB_MAX_UPLOAD_MB).
# Vazio = deixa o padrão do código (2048 MB).
MAX_UPLOAD_MB=""

# Caminho consultado pelo `status` para ver se a APLICAÇÃO responde (e não só
# o arquivo estático). /api/estado é público e devolve JSON sem login.
CAMINHO_SAUDE="/api/estado"

# Interpretador base, usado SÓ para criar o .venv (depois quem manda é o
# python de dentro dele). Vazio = descobre sozinho (/usr/bin/python3 → PATH),
# exigindo 3.11+. Fixe aqui se a VM tiver várias versões.
PYTHON_BIN=""

# Pasta do ambiente virtual. Vazio = .venv na raiz do repositório (gitignorado).
VENV_DIR=""
