[Unit]
Description=Verificar e implantar main da Auditoria JB
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -I /usr/local/lib/auditoria-jb-autodeploy/runner.py --config /etc/auditoria-jb/autodeploy.json --once
Restart=no
TimeoutStartSec=2h
PrivateTmp=true
StandardOutput=journal
StandardError=journal
